@startuml architecture
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle

title Inventory Web Service - Hexagonal Architecture with Multi-Database Persistence

package "Clients & Consumers" {
    [API Client / Frontend] as Client
    [Postman Test Suite] as Postman
    [Godog BDD Runner] as Godog
}

package "Primary / Driving Adapters (Inbound)" {
    package "HTTP Layer" {
        [Tenant Middleware] as TenantMW
        [Item Handler] as ItemHandler
        [Stock Handler] as StockHandler
        [Valuation Handler] as ValuationHandler
        [Purchase Order Handler] as POHandler
    }
}

package "Core Domain & Application Ports" {
    package "Ports" {
        interface "ItemService" as IItemService
        interface "StockService" as IStockService
        interface "ValuationService" as IValuationService
        interface "PurchaseOrderService" as IPOService
        interface "ItemRepository" as IItemRepo
        interface "StockRepository" as IStockRepo
        interface "ValuationRepository" as IValuationRepo
        interface "SupplierRepository" as ISupplierRepo
        interface "PurchaseOrderRepository" as IPORepo
    }

    package "Domain Logic & Models" {
        [Item Domain Entity] as ItemEntity
        [Stock Movement Entity] as StockEntity
        [Cost Layer & Valuation Models] as ValuationEntity
        [Supplier & Purchase Order Entities] as POEntity
        [Inventory & FIFO Invariants] as DomainRules
    }
}

package "Secondary / Driven Adapters (Outbound)" {
    package "SQL Persistence Layer" {
        package "Database-Agnostic Repositories" {
            [SQL Item Repository] as SqlItemRepo
            [SQL Stock Repository] as SqlStockRepo
            [SQL Valuation Repository] as SqlValuationRepo
            [SQL Supplier Repository] as SqlSupplierRepo
            [SQL Purchase Order Repository] as SqlPORepo
        }

        package "Dialect Abstraction Engine" {
            interface "Dialect" as IDialect {
                +Rebind(query)
                +IsUniqueConstraintViolation(err)
                +UpsertStockLevelQuery()
                +UpsertTenantSettingsQuery()
                +FormatTime / ParseTime
                +FormatBool / ParseBool
            }
            [SQLite Dialect (?)] as SQLiteDialect
            [PostgreSQL Dialect ($n)] as PostgresDialect
            [Oracle Dialect (:n, MERGE)] as OracleDialect
        }

        package "Migration Engine" {
            [Schema Migration Runner] as MigrationRunner
            [Embedded DDL Scripts\n(sqlite, postgres, oracle)] as EmbeddedDDL
        }
    }
}

database "Target SQL Database\n(Configurable via DATABASE_DRIVER)" as SQLDB {
    [SQLite (file / :memory:)] as DB_SQLite
    [PostgreSQL (12+ / 16+)] as DB_Postgres
    [Oracle (19c / 21c / 23ai)] as DB_Oracle
}

Client --> TenantMW : HTTP Request (X-Tenant-ID)
Postman --> TenantMW : HTTP Request (X-Tenant-ID)
Godog --> TenantMW : Test HTTP Execution

TenantMW --> ItemHandler : Scoped Context
TenantMW --> StockHandler : Scoped Context
TenantMW --> ValuationHandler : Scoped Context
TenantMW --> POHandler : Scoped Context

ItemHandler --> IItemService
StockHandler --> IStockService
ValuationHandler --> IValuationService
POHandler --> IPOService

IPOService ..> IStockService : restocks via StockIn
IItemService ..> ItemEntity
IStockService ..> StockEntity
IValuationService ..> ValuationEntity
IPOService ..> POEntity
ItemEntity ..> DomainRules
StockEntity ..> DomainRules
ValuationEntity ..> DomainRules
POEntity ..> DomainRules

IItemService --> IItemRepo
IStockService --> IStockRepo
IValuationService --> IValuationRepo
IPOService --> ISupplierRepo
IPOService --> IPORepo

SqlItemRepo .up.|> IItemRepo
SqlStockRepo .up.|> IStockRepo
SqlValuationRepo .up.|> IValuationRepo
SqlSupplierRepo .up.|> ISupplierRepo
SqlPORepo .up.|> IPORepo

SqlItemRepo ..> IDialect : rebinds & parses
SqlStockRepo ..> IDialect : rebinds & parses
SqlValuationRepo ..> IDialect : rebinds & parses
SqlSupplierRepo ..> IDialect : rebinds & parses
SqlPORepo ..> IDialect : rebinds & parses

SQLiteDialect .up.|> IDialect
PostgresDialect .up.|> IDialect
OracleDialect .up.|> IDialect

MigrationRunner ..> EmbeddedDDL : loads .up.sql
MigrationRunner --> SQLDB : executes schema_migrations

SqlItemRepo --> SQLDB : parameterized SQL
SqlStockRepo --> SQLDB : parameterized SQL
SqlValuationRepo --> SQLDB : parameterized SQL
SqlSupplierRepo --> SQLDB : parameterized SQL
SqlPORepo --> SQLDB : parameterized SQL

@enduml
