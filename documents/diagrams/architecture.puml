@startuml architecture
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle

title Inventory Web Service - Hexagonal Architecture

package "Clients & Consumers" {
    [API Client / Frontend] as Client
    [Postman Test Suite] as Postman
    [Godog BDD Runner] as Godog
}

package "Primary / Driving Adapters (Inbound)" {
    package "HTTP Layer" {
        [Tenant Middleware] as TenantMW
        [Item Handler] as ItemHandler
        [Stock Handler] as StockHandler
        [Valuation Handler] as ValuationHandler
        [Purchase Order Handler] as POHandler
    }
}

package "Core Domain & Application Ports" {
    package "Ports" {
        interface "ItemService" as IItemService
        interface "StockService" as IStockService
        interface "ValuationService" as IValuationService
        interface "PurchaseOrderService" as IPOService
        interface "ItemRepository" as IItemRepo
        interface "StockRepository" as IStockRepo
        interface "ValuationRepository" as IValuationRepo
        interface "SupplierRepository" as ISupplierRepo
        interface "PurchaseOrderRepository" as IPORepo
    }

    package "Domain Logic & Models" {
        [Item Domain Entity] as ItemEntity
        [Stock Movement Entity] as StockEntity
        [Cost Layer & Valuation Models] as ValuationEntity
        [Supplier & Purchase Order Entities] as POEntity
        [Inventory & FIFO Invariants] as DomainRules
    }
}

package "Secondary / Driven Adapters (Outbound)" {
    package "Persistence Layer" {
        [SQLite Item Repository] as SqliteItemRepo
        [SQLite Stock Repository] as SqliteStockRepo
        [SQLite Valuation Repository] as SqliteValuationRepo
        [SQLite Supplier Repository] as SqliteSupplierRepo
        [SQLite Purchase Order Repository] as SqlitePORepo
    }
}

database "SQLite Database\n(File or :memory:)" as SQLite

Client --> TenantMW : HTTP Request (X-Tenant-ID)
Postman --> TenantMW : HTTP Request (X-Tenant-ID)
Godog --> TenantMW : Test HTTP Execution

TenantMW --> ItemHandler : Scoped Context
TenantMW --> StockHandler : Scoped Context
TenantMW --> ValuationHandler : Scoped Context
TenantMW --> POHandler : Scoped Context

ItemHandler --> IItemService
StockHandler --> IStockService
ValuationHandler --> IValuationService
POHandler --> IPOService

IPOService ..> IStockService : restocks via StockIn
IItemService ..> ItemEntity
IStockService ..> StockEntity
IValuationService ..> ValuationEntity
IPOService ..> POEntity
ItemEntity ..> DomainRules
StockEntity ..> DomainRules
ValuationEntity ..> DomainRules
POEntity ..> DomainRules

IItemService --> IItemRepo
IStockService --> IStockRepo
IValuationService --> IValuationRepo
IPOService --> ISupplierRepo
IPOService --> IPORepo

SqliteItemRepo .up.|> IItemRepo
SqliteStockRepo .up.|> IStockRepo
SqliteValuationRepo .up.|> IValuationRepo
SqliteSupplierRepo .up.|> ISupplierRepo
SqlitePORepo .up.|> IPORepo

SqliteItemRepo --> SQLite : SQL with tenant_id filter
SqliteStockRepo --> SQLite : SQL with tenant_id filter
SqliteValuationRepo --> SQLite : SQL with tenant_id filter
SqliteSupplierRepo --> SQLite : SQL with tenant_id filter
SqlitePORepo --> SQLite : SQL with tenant_id filter

@enduml
