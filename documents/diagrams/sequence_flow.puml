@startuml sequence_flow
!theme plain
autonumber

title Request Execution Flow & Tenant Context

actor "Client / Postman / Godog" as Client
participant "TenantMiddleware" as MW
participant "ItemHandler / StockHandler" as Handler
participant "ItemService / StockService" as Service
participant "SQLite Repo" as Repo
database "SQLite DB" as DB

== Request without Tenant ID ==
Client -> MW : POST /api/v1/items (No X-Tenant-ID)
activate MW
MW --> Client : 400 Bad Request\n{"error": "X-Tenant-ID header is required"}
deactivate MW

== Valid Multi-Tenant Request ==
Client -> MW : POST /api/v1/items\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"sku": "SKU-001", "name": "Hammer"}
activate MW
MW -> MW : Validate header presence & format
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler

Handler -> Handler : Decode JSON payload & validate input
Handler -> Service : CreateItem(ctx, cmd)
activate Service

Service -> Repo : ExistsBySKU(ctx, tenantID, "SKU-001")
activate Repo
Repo -> DB : SELECT 1 FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : None
Repo --> Service : false
deactivate Repo

Service -> Service : Build Item entity with generated UUID
Service -> Repo : Save(ctx, item)
activate Repo
Repo -> DB : INSERT INTO items (id, tenant_id, sku, ...) VALUES (?, ?, ?, ...)
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo

Service --> Handler : createdItem, nil
deactivate Service

Handler --> Client : 201 Created\n{"id": "...", "sku": "SKU-001", "tenant_id": "tenant-acme", ...}
deactivate Handler
deactivate MW

== Update Item Details ==
Client -> MW : PUT /api/v1/items/sku/{sku}\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"name": "Pro Hammer", ...}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : UpdateItem(ctx, cmd)
activate Service
Service -> Repo : GetBySKU(ctx, tenantID, sku)
activate Repo
Repo -> DB : SELECT * FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : Item row
Repo --> Service : Item entity
deactivate Repo
Service -> Service : item.Update(params)
Service -> Repo : Update(ctx, item)
activate Repo
Repo -> DB : UPDATE items SET ... WHERE tenant_id = ? AND id = ?
DB --> Repo : RowsAffected = 1
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : updatedItem, nil
deactivate Service
Handler --> Client : 200 OK\n{"sku": "SKU-001", "name": "Pro Hammer", ...}
deactivate Handler
deactivate MW

== Inter-Warehouse Stock Transfer ==
Client -> MW : POST /api/v1/items/sku/{sku}/stock/transfer\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"source_warehouse_id": "WH-A", "target_warehouse_id": "WH-B", "quantity": 10}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : StockTransfer(ctx, cmd)
activate Service
Service -> Repo : GetBySKU(ctx, tenantID, sku)
activate Repo
Repo -> DB : SELECT * FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : item (Active)
Repo --> Service : item
deactivate Repo
Service -> Repo : GetStock(ctx, tenantID, itemID, "WH-A")
activate Repo
Repo -> DB : SELECT quantity FROM stock_levels WHERE ...
DB --> Repo : quantity = 50
Repo --> Service : stock (Quantity >= 10)
deactivate Repo
Service -> Repo : RecordTransfer(ctx, outMv, inMv, newSrcBal, newDestBal)
activate Repo
Repo -> DB : BEGIN TRANSACTION
Repo -> DB : INSERT stock_movements (TRANSFER_OUT)
Repo -> DB : INSERT stock_movements (TRANSFER_IN)
Repo -> DB : UPDATE stock_levels (WH-A balance = 40)
Repo -> DB : UPDATE stock_levels (WH-B balance = 10)
Repo -> DB : COMMIT
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : StockTransferResult, nil
deactivate Service
Handler --> Client : 200 OK\n{"source_warehouse_id": "WH-A", "target_warehouse_id": "WH-B", "quantity": 10, ...}
deactivate Handler
deactivate MW

@enduml
