@startuml sequence_flow
!theme plain
autonumber

title Request Execution Flow & Tenant Context

actor "Client / Postman / Godog" as Client
participant "TenantMiddleware" as MW
participant "ItemHandler" as Handler
participant "ItemService" as Service
participant "SQLiteItemRepo" as Repo
database "SQLite DB" as DB

== Request without Tenant ID ==
Client -> MW : POST /api/v1/items (No X-Tenant-ID)
activate MW
MW --> Client : 400 Bad Request\n{"error": "X-Tenant-ID header is required"}
deactivate MW

== Valid Multi-Tenant Request ==
Client -> MW : POST /api/v1/items\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"sku": "SKU-001", "name": "Hammer"}
activate MW
MW -> MW : Validate header presence & format
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler

Handler -> Handler : Decode JSON payload & validate input
Handler -> Service : CreateItem(ctx, cmd)
activate Service

Service -> Repo : ExistsBySKU(ctx, tenantID, "SKU-001")
activate Repo
Repo -> DB : SELECT 1 FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : None
Repo --> Service : false
deactivate Repo

Service -> Service : Build Item entity with generated UUID
Service -> Repo : Save(ctx, item)
activate Repo
Repo -> DB : INSERT INTO items (id, tenant_id, sku, ...) VALUES (?, ?, ?, ...)
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo

Service --> Handler : createdItem, nil
deactivate Service

Handler --> Client : 201 Created\n{"id": "...", "sku": "SKU-001", "tenant_id": "tenant-acme", ...}
deactivate Handler
deactivate MW

== Update Item Details ==
Client -> MW : PUT /api/v1/items/sku/{sku}\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"name": "Pro Hammer", ...}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : UpdateItem(ctx, cmd)
activate Service
Service -> Repo : GetBySKU(ctx, tenantID, sku)
activate Repo
Repo -> DB : SELECT * FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : Item row
Repo --> Service : Item entity
deactivate Repo
Service -> Service : item.Update(params)
Service -> Repo : Update(ctx, item)
activate Repo
Repo -> DB : UPDATE items SET ... WHERE tenant_id = ? AND id = ?
DB --> Repo : RowsAffected = 1
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : updatedItem, nil
deactivate Service
Handler --> Client : 200 OK\n{"sku": "SKU-001", "name": "Pro Hammer", ...}
deactivate Handler
deactivate MW

@enduml
