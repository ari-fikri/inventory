@startuml sequence_flow
!theme plain
autonumber

title Request Execution Flow & Tenant Context

actor "Client / Postman / Godog" as Client
participant "TenantMiddleware" as MW
participant "ItemHandler / StockHandler" as Handler
participant "ItemService / StockService" as Service
participant "SQLite Repo" as Repo
database "SQLite DB" as DB

== Request without Tenant ID ==
Client -> MW : POST /api/v1/items (No X-Tenant-ID)
activate MW
MW --> Client : 400 Bad Request\n{"error": "X-Tenant-ID header is required"}
deactivate MW

== Valid Multi-Tenant Request ==
Client -> MW : POST /api/v1/items\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"sku": "SKU-001", "name": "Hammer"}
activate MW
MW -> MW : Validate header presence & format
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler

Handler -> Handler : Decode JSON payload & validate input
Handler -> Service : CreateItem(ctx, cmd)
activate Service

Service -> Repo : ExistsBySKU(ctx, tenantID, "SKU-001")
activate Repo
Repo -> DB : SELECT 1 FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : None
Repo --> Service : false
deactivate Repo

Service -> Service : Build Item entity with generated UUID
Service -> Repo : Save(ctx, item)
activate Repo
Repo -> DB : INSERT INTO items (id, tenant_id, sku, ...) VALUES (?, ?, ?, ...)
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo

Service --> Handler : createdItem, nil
deactivate Service

Handler --> Client : 201 Created\n{"id": "...", "sku": "SKU-001", "tenant_id": "tenant-acme", ...}
deactivate Handler
deactivate MW

== Update Item Details ==
Client -> MW : PUT /api/v1/items/sku/{sku}\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"name": "Pro Hammer", ...}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : UpdateItem(ctx, cmd)
activate Service
Service -> Repo : GetBySKU(ctx, tenantID, sku)
activate Repo
Repo -> DB : SELECT * FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : Item row
Repo --> Service : Item entity
deactivate Repo
Service -> Service : item.Update(params)
Service -> Repo : Update(ctx, item)
activate Repo
Repo -> DB : UPDATE items SET ... WHERE tenant_id = ? AND id = ?
DB --> Repo : RowsAffected = 1
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : updatedItem, nil
deactivate Service
Handler --> Client : 200 OK\n{"sku": "SKU-001", "name": "Pro Hammer", ...}
deactivate Handler
deactivate MW

== Inter-Warehouse Stock Transfer ==
Client -> MW : POST /api/v1/items/sku/{sku}/stock/transfer\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"source_warehouse_id": "WH-A", "target_warehouse_id": "WH-B", "quantity": 10}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : StockTransfer(ctx, cmd)
activate Service
Service -> Repo : GetBySKU(ctx, tenantID, sku)
activate Repo
Repo -> DB : SELECT * FROM items WHERE tenant_id = ? AND sku = ?
DB --> Repo : item (Active)
Repo --> Service : item
deactivate Repo
Service -> Repo : GetStock(ctx, tenantID, itemID, "WH-A")
activate Repo
Repo -> DB : SELECT quantity FROM stock_levels WHERE ...
DB --> Repo : quantity = 50
Repo --> Service : stock (Quantity >= 10)
deactivate Repo
Service -> Repo : RecordTransfer(ctx, outMv, inMv, newSrcBal, newDestBal)
activate Repo
Repo -> DB : BEGIN TRANSACTION
Repo -> DB : INSERT stock_movements (TRANSFER_OUT)
Repo -> DB : INSERT stock_movements (TRANSFER_IN)
Repo -> DB : UPDATE stock_levels (WH-A balance = 40)
Repo -> DB : UPDATE stock_levels (WH-B balance = 10)
Repo -> DB : COMMIT
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : StockTransferResult, nil
deactivate Service
Handler --> Client : 200 OK\n{"source_warehouse_id": "WH-A", "target_warehouse_id": "WH-B", "quantity": 10, ...}
deactivate Handler
deactivate MW

== Restock with Unit Cost & FIFO Cost Layer Creation ==
Client -> MW : POST /api/v1/items/sku/{sku}/stock/in\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"quantity": 10, "unit_cost": 15.50}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : StockIn(ctx, cmd)
activate Service
Service -> Service : Create domain.CostLayer(qty: 10, cost: 15.50)
Service -> Repo : RecordMovementWithCostLayer(ctx, mv, bal, costLayer)
activate Repo
Repo -> DB : BEGIN TRANSACTION
Repo -> DB : INSERT INTO stock_movements (IN, qty: 10)
Repo -> DB : UPDATE stock_levels (qty: +10)
Repo -> DB : INSERT INTO stock_cost_layers (rem_qty: 10, unit_cost: 15.50)
Repo -> DB : COMMIT
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : StockMovement, StockLevel, nil
deactivate Service
Handler --> Client : 200 OK
deactivate Handler
deactivate MW

== Stock Out with FIFO Cost Layer Consumption & COGS ==
Client -> MW : POST /api/v1/items/sku/{sku}/stock/out\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"quantity": 15}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : StockOut(ctx, cmd)
activate Service
Service -> Repo : GetActiveCostLayers(ctx, tenantID, itemID, wh)
activate Repo
Repo -> DB : SELECT * FROM stock_cost_layers WHERE remaining_quantity > 0 ORDER BY rowid ASC
DB --> Repo : Layer 1 (rem: 10 @ $10), Layer 2 (rem: 10 @ $20)
Repo --> Service : CostLayers
deactivate Repo
Service -> Service : Consume Layer 1 (take: 10, cogs: $100)\nConsume Layer 2 (take: 5, cogs: $100)\nTotal COGS = $200
Service -> Repo : RecordStockOutWithValuation(ctx, mv, bal, consumed)
activate Repo
Repo -> DB : BEGIN TRANSACTION
Repo -> DB : INSERT INTO stock_movements (OUT, qty: 15, total_cogs: 200.0)
Repo -> DB : UPDATE stock_levels (qty: -15)
Repo -> DB : UPDATE stock_cost_layers SET remaining_quantity = 0 (Layer 1)
Repo -> DB : UPDATE stock_cost_layers SET remaining_quantity = 5 (Layer 2)
Repo -> DB : COMMIT
DB --> Repo : OK
Repo --> Service : nil (Success)
deactivate Repo
Service --> Handler : StockMovement, StockLevel, nil
deactivate Service
Handler --> Client : 200 OK\n{"quantity": 15, "total_cogs": 200.00}
deactivate Handler
deactivate MW

== Valuation Method Change Guard (Stock > 0 Restriction) ==
Client -> MW : PUT /api/v1/valuation/settings\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"valuation_method": "AVCO"}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : SetTenantValuationMethod(ctx, tenantID, "AVCO")
activate Service
Service -> Repo : GetTenantTotalStock(ctx, tenantID)
activate Repo
Repo -> DB : SELECT COALESCE(SUM(quantity), 0) FROM stock_levels WHERE tenant_id = ?
DB --> Repo : total_stock = 15
Repo --> Service : 15
deactivate Repo
Service --> Handler : ErrCannotChangeValuation
deactivate Service
Handler --> Client : 400 Bad Request\n{"error": "cannot change valuation method when stock is greater than zero"}
deactivate Handler
deactivate MW

== Purchase Order Lifecycle & Receiving Workflow ==
Client -> MW : POST /api/v1/purchase-orders\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"po_number": "PO-1001", "supplier_id": "sup-1", "warehouse_id": "WH-MAIN", "items": [{"sku": "SKU-A", "quantity": 100, "unit_cost": 50.0}]}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : CreatePurchaseOrder(ctx, cmd)
activate Service
Service -> Repo : Create(ctx, po)
activate Repo
Repo -> DB : INSERT INTO purchase_orders, purchase_order_items (Status: DRAFT)
DB --> Repo : OK
Repo --> Service : nil
deactivate Repo
Service --> Handler : PurchaseOrder (DRAFT), nil
deactivate Service
Handler --> Client : 201 Created (PO Status: DRAFT)
deactivate Handler
deactivate MW

Client -> MW : PATCH /api/v1/purchase-orders/PO-1001/submit\nHeader: X-Tenant-ID: "tenant-acme"
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : SubmitPurchaseOrder(ctx, tenantID, "PO-1001")
activate Service
Service -> Repo : Update(ctx, po with status: ORDERED)
activate Repo
Repo -> DB : UPDATE purchase_orders SET status = 'ORDERED'
DB --> Repo : OK
Repo --> Service : nil
deactivate Repo
Service --> Handler : PurchaseOrder (ORDERED), nil
deactivate Service
Handler --> Client : 200 OK (PO Status: ORDERED)
deactivate Handler
deactivate MW

Client -> MW : POST /api/v1/purchase-orders/PO-1001/receive\nHeader: X-Tenant-ID: "tenant-acme"\nBody: {"items": [{"sku": "SKU-A", "received_quantity": 60}]}
activate MW
MW -> Handler : ctx = WithTenantID(ctx, "tenant-acme")
activate Handler
Handler -> Service : ReceivePurchaseOrder(ctx, cmd)
activate Service
Service -> Service : Validate PO status (ORDERED/PARTIALLY_RECEIVED)\nValidate received_qty <= remaining_qty
Service -> Service : StockService.StockIn(Tenant, SKU-A, WH-MAIN, Qty: 60, UnitCost: $50)
activate Service #DarkSalmon
Service -> Repo : RecordMovementWithCostLayer(IN, Qty: 60, UnitCost: $50)
activate Repo
Repo -> DB : UPDATE stock_levels (+60)\nINSERT stock_cost_layers (rem: 60, cost: $50)
DB --> Repo : OK
Repo --> Service : nil
deactivate Repo
deactivate Service
Service -> Repo : UpdateItemReceivedQty(item_id, 60)
activate Repo
Repo -> DB : UPDATE purchase_order_items SET received_quantity = 60
DB --> Repo : OK
Repo --> Service : nil
deactivate Repo
Service -> Repo : Update(ctx, po with status: PARTIALLY_RECEIVED)
activate Repo
Repo -> DB : UPDATE purchase_orders SET status = 'PARTIALLY_RECEIVED'
DB --> Repo : OK
Repo --> Service : nil
deactivate Repo
Service --> Handler : PurchaseOrder (PARTIALLY_RECEIVED), nil
deactivate Service
Handler --> Client : 200 OK (PO Status: PARTIALLY_RECEIVED, Warehouse stock: 60, FIFO layer: $50)
deactivate Handler
deactivate MW

@enduml
