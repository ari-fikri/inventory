{
  "info": {
    "_postman_id": "inventory-service-api-collection",
    "name": "Inventory Web Service API",
    "description": "Postman test suite for Multi-Tenant Inventory Web Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tenant Isolation",
      "item": [
        {
          "name": "Reject Request Missing X-Tenant-ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response returns missing tenant error\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"X-Tenant-ID header is required\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Item - Cross Tenant Same SKU Allowed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created for second tenant\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Item created under tenant_beta with identical SKU\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.sku).to.eql(\"SKU-001\");",
                  "    pm.expect(jsonData.tenant_id).to.eql(pm.environment.get(\"tenant_beta\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_beta}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001\",\n  \"name\": \"Beta Ergonomic Keyboard\",\n  \"description\": \"Tenant Beta independent item\",\n  \"unit_price\": 109.99,\n  \"min_threshold\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            }
          },
          "response": []
        },
