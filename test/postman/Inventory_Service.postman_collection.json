    {
      "name": "Stock Management",
      "item": [
        {
          "name": "Stock IN (Restock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Stock updated accurately\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.quantity).to.be.at.least(50);",
                  "    pm.expect(jsonData.movement_type).to.eql(\"IN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
