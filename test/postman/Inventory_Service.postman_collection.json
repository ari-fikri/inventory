{
  "info": {
    "_postman_id": "inventory-service-api-collection",
    "name": "Inventory Web Service API",
    "description": "Postman test suite for Multi-Tenant Inventory Web Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tenant Isolation",
      "item": [
        {
          "name": "Reject Request Missing X-Tenant-ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response returns missing tenant error\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"X-Tenant-ID header is required\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Create Item Successfully",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Item created with expected tenant and sku\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.sku).to.eql(\"SKU-001\");",
                  "    pm.expect(jsonData.name).to.eql(\"Ergonomic Keyboard\");",
                  "    pm.expect(jsonData.tenant_id).to.eql(pm.environment.get(\"tenant_alpha\"));",
                  "    pm.expect(jsonData.is_active).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_alpha}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001\",\n  \"name\": \"Ergonomic Keyboard\",\n  \"description\": \"Mechanical keyboard\",\n  \"unit_price\": 99.50,\n  \"min_threshold\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject Duplicate SKU within Same Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Response returns duplicate SKU error message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"item with this SKU already exists for this tenant\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_alpha}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001\",\n  \"name\": \"Duplicate Keyboard\",\n  \"description\": \"Another keyboard\",\n  \"unit_price\": 49.99,\n  \"min_threshold\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
